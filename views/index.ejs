<%- include('partials/header', { title: "Home" }) %>

<h1>Posts</h1>

<form action="/add-post" method="POST">
    <textarea name="content" placeholder="Write something..." required></textarea>
    <br>
    <button type="submit">Post</button>
</form>

<hr>

<% posts.forEach(post => { %>
    <div>
        <p><%= post.content %></p>
    </div>
<% }) %>

<%- include('partials/footer') %>