<%- include('partials/header', { title: "Home Page" }) %> <!-- Inkluderer header-partial med tittel -->

<h1>What's on you mind?</h1> <!-- Overskrift for siden -->

<form action="/add-post" method="POST"> <!-- Skjema for å legge til ny post -->
    <textarea class="textarea" name="content" placeholder="Write something..." required></textarea> <!-- Tekstfelt for innhold -->
    <br> <!-- Enkel linjeskift -->
    <button type="submit">Post</button> <!-- Knapp for å sende inn posten -->
</form> <!-- Slutt på skjema -->
<br><br>

<!-- Toolbar over post-lista -->
<div class="feed-toolbar"> <!-- En rad for sorteringsvalg -->
  <a href="/?sort=latest"
    class="feed-link <%= (typeof currentSort !== 'undefined' && currentSort === 'latest') ? 'active' : '' %>">
    Latest
  </a>
  <a href="/?sort=trending"
    class="feed-link <%= (typeof currentSort !== 'undefined' && currentSort === 'trending') ? 'active' : '' %>">
    Trending
  </a>
</div>

<section class="posts-list"> <!-- Container for all top-level posts -->
  <% posts.forEach(post => { %> <!-- Loop over each top-level post -->
    <article class="post-box"> <!-- One post “card/box” -->
      <p> <!-- Header line: author + time -->
        <strong><a href="/u/<%= encodeURIComponent(post.username) %>"><%= post.username %></a></strong> <!-- Klikkbar lenke til offentlig profil -->
        • <!-- Separator -->
        <%= typeof formatPostTime === 'function' 
              ? formatPostTime(post.created_at) 
              : (post.created_at ? new Date(post.created_at).toLocaleString('nb-NO') : 'Ukjent tidspunkt') %> <!-- Time with your helper or fallback -->
      </p> <!-- End header -->

      <p class="post-content"><%= post.content %></p> <!-- Post text; CSS preserves line breaks -->

      <div class="actions-row"> <!-- Row with like + comments count -->
        <button
          type="button"                                                   
          class="like-btn"                                                
          data-post-id="<%= post.PostID %>"                               
          aria-pressed="<%= post.liked ? 'true' : 'false' %>">            <!-- Accessibility state -->
          <span class="like-label"><%= post.liked ? 'Unlike ❤️' : 'Like ❤️' %></span> <!-- Button label -->
          ( <span class="like-count"><%= post.likeCount %></span> )             <!-- Like counter -->
        </button> <!-- End like button -->

        <span class="comment-label">Comments:</span>  <!-- Label for comments count -->
        <span class="comment-count" data-parent-id="<%= post.PostID %>"> <!-- Shows current number of comments -->
          <%= post.commentCount %> <!-- Server rendered Comment count -->
        </span> <!-- End comments count -->

        <% if (post.commentCount > 0) { %> <!-- Only show toggle if there are comments -->
          <button
            type="button" 
            class="comments-toggle" 
            data-parent-id="<%= post.PostID %>"> <!-- The post whose comments we’ll show/hide -->
            View <%= post.commentCount %> comments <!-- Initial label (collapsed by default) -->
          </button> <!-- End toggle -->
        <% } %> <!-- End conditional toggle -->
      </div> <!-- End actions row -->

      <% if (userId) { %> <!-- Only show comment input if the user is logged in -->
        <div class="comment-form-row"> <!-- Inline comment form row -->
          <textarea
            class="comment-input"                                   
            data-parent-id="<%= post.PostID %>"                     
            placeholder="Write a comment..."                        
            rows="1"></textarea>                                    <!-- Starts small; grows automatically -->
          <button
            type="button"                                           
            class="comment-send"                                    
            data-parent-id="<%= post.PostID %>">                    <!-- Parent post id for API -->
            Send <!-- Button label -->
          </button> <!-- End send button -->
        </div> <!-- End comment form row -->
      <% } else { %> <!-- If user is logged out -->
        <small><br>Log in to comment</small> <!-- Hint for guests -->
      <% } %> <!-- End login check -->

      <div class="comment-list hidden" data-parent-id="<%= post.PostID %>" data-visible-count="<%= Math.min(5, (commentsByParent[post.PostID] || []).length) %>"> <!-- Skjult ved start; lagrer synlig-antall -->
          <% const comments = commentsByParent[post.PostID] || []; %> <!-- Henter kommentarer for denne posten -->
          <% comments.forEach((c, i) => { %> <!-- Løkke med indeks for å styre synlighet -->
            <div class="comment <%= i >= 5 ? 'hidden' : '' %>" data-idx="<%= i %>"> <!-- Skjuler kommentarer utover de første 5 -->
              <p class="comment-header"> <!-- Header med forfatter + tidspunkt -->
                <strong><a href="/u/<%= encodeURIComponent(c.username) %>"><%= c.username %></a></strong> <!-- Klikkbar forfatter i kommentar --> • 
                <%= typeof formatPostTime === 'function' 
                      ? formatPostTime(c.created_at) 
                      : (c.created_at ? new Date(c.created_at).toLocaleString('nb-NO') : 'Ukjent tidspunkt') %>
              </p> <!-- Slutt header -->
              <p class="post-content"><%= c.content %></p> <!-- Selve kommentarteksten -->
            </div> <!-- Slutt én kommentar -->
          <% }) %> <!-- Slutt løkke -->
          <% if (comments.length > 5) { %> <!-- Bare vis paginerings-knapper hvis det er flere enn 5 -->
            <div class="comments-pagination" data-parent-id="<%= post.PostID %>"> <!-- Beholder for Vis mer/Vis mindre -->
              <button 
                type="button" 
                class="comments-toggle comments-more" 
                data-parent-id="<%= post.PostID %>">Show more</button> <!-- Vis flere -->
              <button 
                type="button" 
                class="comments-toggle comments-less hidden" 
                data-parent-id="<%= post.PostID %>">Show less</button> <!-- Vis færre (skjult ved start) -->
            </div> <!-- Slutt pagineringsbeholder -->
          <% } %> <!-- Slutt if -->
        </div> <!-- Slutt kommentarliste -->
    </article> <!-- End one post -->
  <% }) %> <!-- End posts loop -->
</section> <!-- End posts list -->


<%- include('partials/footer') %> <!-- Inkluderer footer-partial (lukker main/body/html) -->





