<%- include('partials/header', { title: "Profil" }) %> <!-- Inkluderer header-partial med tittel -->

<h1>Min profil</h1> <!-- Overskrift for profilsiden -->

<div> <!-- Starter en container for brukerinfo -->
    <p><strong>Brukernavn:</strong> <%= user.username %></p> <!-- Viser brukernavn -->
    <p><strong>Antall poster:</strong> <%= user.postCount %></p> <!-- Viser antall poster -->
    <p> <!-- Starter rad for dato -->
      <strong>Konto opprettet:</strong> <!-- Label for dato -->
      <%= new Date(user.created_at) // Lager et Date-objekt fra ISO-strengen
        .toLocaleDateString('nb-NO', { // Formaterer kun dato i norsk format
          year: 'numeric', // Viser år med fire siffer
          month: '2-digit', // Viser måned med to siffer
          day: '2-digit' // Viser dag med to siffer
        }) %> <!-- Slutt på EJS-uttrykk -->
    </p> <!-- Slutter rad for dato -->
</div> <!-- Slutter container for brukerinfo -->

<button id="logoutBtn" type="button">Logg ut</button> <!-- En vanlig knapp (ikke form), som vi fanger i JS -->

<h2>Mine innlegg</h2> <!-- Overskrift for seksjonen med egne innlegg -->

<section class="posts-list"> <!-- Beholder for alle egne poster -->
  <% if (posts && posts.length) { %> <!-- Sjekker om det finnes noen poster -->
    <% posts.forEach(post => { %> <!-- Løkke over hver post sendt fra serveren -->
      <article class="post-box"> <!-- En boks for én post -->
        <p> <!-- Topp-linje med tidspunkt for posten -->
          <%= typeof formatPostTime === 'function' // Hvis du har helperen formatPostTime
                ? formatPostTime(post.created_at) // Bruk helperen som viser dato+tid (<24t) eller bare dato (>=24t)
                : (post.created_at                // Ellers: enkel fallback-formattering direkte i EJS
                    ? new Date(post.created_at).toLocaleString('nb-NO', { year:'numeric', month:'2-digit', day:'2-digit', hour:'2-digit', minute:'2-digit' })
                    : 'Ukjent tidspunkt') %> <!-- Fallback hvis created_at mangler -->
        </p> <!-- Slutt topp-linje -->

        <p class="post-content"><%= post.content %></p> <!-- Bevarer linjeskift og bryter lange ord -->

        <button type="button" class="like-btn"
          data-post-id="<%= post.PostID %>"               
          aria-pressed="<%= post.liked ? 'true' : 'false' %>"> <!-- Tilstand for tilgjengelighet -->
          <span class="like-label"><%= post.liked ? 'Unlike' : 'Like' %></span> <!-- Label for knappen -->
          ( <span class="like-count"><%= post.likes %></span> ) <!-- Teller for likes -->
        </button> <!-- Slutt på like-knapp -->
      </article> <!-- Slutt på én post-boks -->
    <% }) %> <!-- Slutt på løkke -->
  <% } else { %> <!-- Hvis brukeren ikke har noen poster -->
    <p>Ingen innlegg ennå.</p> <!-- Informasjonstekst -->
  <% } %> <!-- Slutt på if/else -->
</section> <!-- Slutt på seksjonen med poster -->

<script>
document.addEventListener('click', async (e) => { // Lytter på alle klikk på siden
  const likeBtn = e.target.closest('.like-btn'); // Prøver å finne en like-knapp nærmest klikket
  const logoutBtn = e.target.closest('#logoutBtn'); // Prøver å finne logout-knappen nærmest klikket

  if (likeBtn) { // Hvis klikket var på en like-knapp
    const postId = likeBtn.dataset.postId; // Leser PostID fra data-attributt
    try { // Starter try-catch for å håndtere feil
      const res = await fetch(`/api/posts/${encodeURIComponent(postId)}/like`, { method: 'POST' }); // Kaller toggle-like API
      if (res.status === 401) { // Sjekker om bruker ikke er innlogget
        alert('You must log in to like.'); // Viser feilmelding
        return; // Stopper videre kjøring
      } // Slutt 401-sjekk
      const data = await res.json(); // Leser JSON-respons
      if (!res.ok || !data.ok) { // Sjekker for API-feil
        alert(data.error || 'Could not update like'); // Viser feilmelding
        return; // Stopper videre kjøring
      } // Slutt feil-sjekk
      likeBtn.setAttribute('aria-pressed', data.liked ? 'true' : 'false'); // Oppdaterer ARIA-tilstand
      const labelEl = likeBtn.querySelector('.like-label'); // Finner label-span
      if (labelEl) labelEl.textContent = data.liked ? 'Unlike' : 'Like'; // Oppdaterer label-tekst
      const countEl = likeBtn.querySelector('.like-count'); // Finner teller-span
      if (countEl) countEl.textContent = data.likes; // Oppdaterer teller
    } catch (err) { // Fanger uventede feil
      console.error('Network or unexpected error:', err); // Logger feilen
      alert('En uventet feil oppstod'); // Viser feilmelding
    } // Slutt catch
    return; // Viktig: returner her så ikke logout-koden under kjøres for samme klikk
  } // Slutt like-håndtering

  if (logoutBtn) { // Hvis klikket var på logout-knappen
    try { // Starter try-catch for logout-kallet
      const res = await fetch('/api/auth/logout', { method: 'POST', headers: { 'Content-Type': 'application/json' } }); // Kaller logout-API
      const data = await res.json(); // Leser JSON-respons
      if (!res.ok || !data.ok) { // Sjekker for API-feil
        alert(data.error || 'Kunne ikke logge ut'); // Viser feilmelding
        return; // Stopper videre kjøring
      } // Slutt feil-sjekk
      window.location.href = '/'; // Redirect til forsiden ved suksess
    } catch (err) { // Fanger uventede feil
      console.error(err); // Logger feilen i konsollen
      alert('En uventet feil oppstod ved utlogging'); // Viser feilmelding
    } // Slutt catch
    return; // Avslutter etter logout-håndtering
  } // Slutt logout-håndtering
}); // Slutt på document-klikklytter
</script>

<%- include('partials/footer') %> <!-- Inkluderer footer-partial -->