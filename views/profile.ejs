<%- include('partials/header', { title: "Profil" }) %> <!-- Inkluderer header-partial med tittel -->

<h1>Min profil</h1> <!-- Overskrift for profilsiden -->

<div> <!-- Starter en container for brukerinfo -->
    <p><strong>Brukernavn:</strong> <%= user.username %></p> <!-- Viser brukernavn -->
    <p><strong>Antall poster:</strong> <%= user.postCount %></p> <!-- Viser antall poster -->
    <p> <!-- Starter rad for dato -->
      <strong>Konto opprettet:</strong> <!-- Label for dato -->
      <%= new Date(user.created_at) // Lager et Date-objekt fra ISO-strengen
        .toLocaleDateString('nb-NO', { // Formaterer kun dato i norsk format
          year: 'numeric', // Viser år med fire siffer
          month: '2-digit', // Viser måned med to siffer
          day: '2-digit' // Viser dag med to siffer
        }) %> <!-- Slutt på EJS-uttrykk -->
    </p> <!-- Slutter rad for dato -->
</div> <!-- Slutter container for brukerinfo -->

<button id="logoutBtn" type="button">Logg ut</button> <!-- En vanlig knapp (ikke form), som vi fanger i JS -->

<script> // Starter inline JavaScript
  const btn = document.getElementById('logoutBtn'); // Henter referanse til knappen via id

  btn.addEventListener('click', async () => { // Lytter på klikk på logg ut-knappen
    try { // Starter try-catch for å håndtere feil i fetch
      const res = await fetch('/api/auth/logout', { // Kaller API-endepunktet for logout
        method: 'POST', // Bruker POST-metoden (bedre semantikk for state-endring)
        headers: { 'Content-Type': 'application/json' } // Setter Content-Type header (ikke strengt nødvendig her)
      }); // Slutt på fetch-kall

      const data = await res.json(); // Leser JSON-responsen fra serveren

      if (!res.ok || !data.ok) { // Sjekker om server svarte med feilstatus eller ok=false
        alert(data.error || 'Kunne ikke logge ut'); // Viser enkel feilmelding til brukeren
        return; // Stopper videre kjøring hvis noe feilet
      } // Slutt på feil-sjekk

      window.location.href = '/'; // Ved suksess: send brukeren til forsiden
    } catch (err) { // Fanger uventede feil (nettverksfeil osv.)
      console.error(err); // Logger feilen i konsollen for debugging
      alert('En uventet feil oppstod ved utlogging'); // Viser enkel feilmelding i UI
    } // Slutt på catch
  }); // Slutt på event listener
</script> <!-- Slutter inline JavaScript -->

<%- include('partials/footer') %> <!-- Inkluderer footer-partial -->