<%- include('partials/header', { title: "Profil" }) %> <!-- Inkluderer header-partial med tittel -->

<h1>Min profil</h1> <!-- Overskrift for profilsiden -->

<div> <!-- Starter en container for brukerinfo -->
    <p><strong>Brukernavn:</strong> <%= user.username %></p> <!-- Viser brukernavn -->
    <p><strong>Antall poster:</strong> <%= user.postCount %></p> <!-- Viser antall poster -->
    <p> <!-- Starter rad for dato -->
      <strong>Konto opprettet:</strong> <!-- Label for dato -->
      <%= new Date(user.created_at) // Lager et Date-objekt fra ISO-strengen
        .toLocaleDateString('nb-NO', { // Formaterer kun dato i norsk format
          year: 'numeric', // Viser år med fire siffer
          month: '2-digit', // Viser måned med to siffer
          day: '2-digit' // Viser dag med to siffer
        }) %> <!-- Slutt på EJS-uttrykk -->
    </p> <!-- Slutter rad for dato -->
</div> <!-- Slutter container for brukerinfo -->

<button id="logoutBtn" type="button">Logg ut</button> <!-- En vanlig knapp (ikke form), som vi fanger i JS -->

<h2>Mine innlegg</h2> <!-- Section title for your own posts -->

<section class="posts-list"> <!-- Container for all your posts -->
  <% if (posts && posts.length) { %> <!-- If there are posts -->
    <% posts.forEach(post => { %> <!-- Loop over each post -->
      <article class="post-box"> <!-- One post “card/box” -->
        <p> <!-- Header line: time only (author is you) -->
          <%= typeof formatPostTime === 'function' 
                ? formatPostTime(post.created_at) 
                : (post.created_at ? new Date(post.created_at).toLocaleString('nb-NO') : 'Ukjent tidspunkt') %>
        </p> <!-- End header -->

        <p class="post-content"><%= post.content %></p> <!-- Post text -->

        <div class="actions-row"> <!-- Row with like + comments count -->
          <button
            type="button"                                                   
            class="like-btn"                                                
            data-post-id="<%= post.PostID %>"                               
            aria-pressed="<%= post.liked ? 'true' : 'false' %>">            <!-- Accessibility state -->
            <span class="like-label"><%= post.liked ? 'Unlike' : 'Like' %></span> <!-- Button label -->
            ( <span class="like-count"><%= post.likeCount %></span> )             <!-- Like counter -->
          </button> <!-- End like button -->

          <span class="comment-count" data-parent-id="<%= post.PostID %>"> <!-- Current number of comments -->
            <p class="comment-count-label">Comments: <%= post.commentCount %></p> <!-- Comment count -->
          </span> <!-- End comment count -->

          <% if (post.commentCount > 0) { %> <!-- Only show toggle if there are comments -->
            <button
              type="button" 
              class="comments-toggle" 
              data-parent-id="<%= post.PostID %>"> <!-- The post whose comments we’ll show/hide -->
              View <%= post.commentCount %> comments <!-- Initial label (collapsed by default) -->
            </button> <!-- End toggle -->
          <% } %> <!-- End conditional toggle -->
        </div> <!-- End actions row -->

        <!-- Comment input (shown when logged in; profile is protected so userId exists) -->
        <div class="comment-form-row"> <!-- Inline comment form row -->
          <textarea
            class="comment-input"                                   
            data-parent-id="<%= post.PostID %>"                    
            placeholder="Write a comment..."                        
            rows="1"></textarea>                                    <!-- Start small -->
          <button
            type="button"                                           
            class="comment-send"                                   
            data-parent-id="<%= post.PostID %>">                    <!-- Parent post id -->
            Send <!-- Button label -->
          </button> <!-- End send button -->
        </div> <!-- End comment form row -->

        <% if (typeof commentsByParent !== 'undefined') { %> <!-- If your route provided commentsByParent -->
          <div class="comment-list hidden" data-parent-id="<%= post.PostID %>" data-visible-count="<%= typeof commentsByParent !== 'undefined' ? Math.min(5, (commentsByParent[post.PostID] || []).length) : 0 %>"> <!-- Skjult ved start -->
            <% const comments = (typeof commentsByParent !== 'undefined' ? (commentsByParent[post.PostID] || []) : []); %> <!-- Henter kommentarer trygt -->
            <% comments.forEach((c, i) => { %> <!-- Løkke med indeks -->
              <div class="comment <%= i >= 5 ? 'hidden' : '' %>" data-idx="<%= i %>"> <!-- Skjul >5 -->
                <p class="comment-header">
                  <strong><%= c.username %></strong> • 
                  <%= typeof formatPostTime === 'function' 
                        ? formatPostTime(c.created_at) 
                        : (c.created_at ? new Date(c.created_at).toLocaleString('nb-NO') : 'Ukjent tidspunkt') %>
                </p>
                <p class="post-content"><%= c.content %></p>
              </div>
            <% }) %>
            <% if (comments.length > 5) { %> <!-- Paginering ved behov -->
              <div class="comments-pagination" data-parent-id="<%= post.PostID %>">
                <button type="button" class="comments-toggle comments-more" data-parent-id="<%= post.PostID %>">Show more</button>
                <button type="button" class="comments-toggle comments-less hidden" data-parent-id="<%= post.PostID %>">Show less</button>
              </div>
            <% } %>
          </div>
        <% } %> <!-- End optional comments list -->
      </article> <!-- End one post -->
    <% }) %> <!-- End posts loop -->
  <% } else { %> <!-- If no posts -->
    <p>Ingen innlegg ennå.</p> <!-- Message -->
  <% } %> <!-- End if -->
</section> <!-- End posts list -->

<script> // Samlet håndtering for logout, like, kommentarer, vis/skjul, paginering og auto-grow
  document.addEventListener('click', async (e) => { // Lytter på alle klikk
    const logoutBtn = e.target.closest('#logoutBtn'); // Sjekk logout
    if (logoutBtn) { // Håndter logout
      try { const res = await fetch('/api/auth/logout', { method: 'POST', headers: { 'Content-Type': 'application/json' } }); const data = await res.json(); if (!res.ok || !data.ok) { alert(data.error || 'Kunne ikke logge ut'); return; } window.location.href = '/'; }
      catch (err) { console.error(err); alert('En uventet feil oppstod ved utlogging'); }
      return; // Avslutt
    } // Slutt logout

    const likeBtn = e.target.closest('.like-btn'); // Sjekk like
    if (likeBtn) { // Håndter like
      const postId = likeBtn.dataset.postId; // PostID
      try { const res = await fetch(`/api/posts/${encodeURIComponent(postId)}/like`, { method: 'POST' }); if (res.status === 401) { alert('You must log in to like.'); return; } const data = await res.json(); if (!res.ok || !data.ok) { alert(data.error || 'Could not update like'); return; } likeBtn.setAttribute('aria-pressed', data.liked ? 'true' : 'false'); const labelEl = likeBtn.querySelector('.like-label'); if (labelEl) labelEl.textContent = data.liked ? 'Unlike' : 'Like'; const countEl = likeBtn.querySelector('.like-count'); if (countEl) countEl.textContent = data.likes; }
      catch (err) { console.error('Like error:', err); alert('Unexpected error'); }
      return; // Avslutt
    } // Slutt like

    const sendBtn = e.target.closest('.comment-send'); // Sjekk “Send”-kommentar
    if (sendBtn) { // Håndter ny kommentar
      const parentId = sendBtn.dataset.parentId; // Parent PostID
      const input = document.querySelector(`.comment-input[data-parent-id="${CSS.escape(parentId)}"]`); // Finn textarea
      if (!input) { alert('Could not find comment input'); return; } // Sikkerhet
      const text = input.value.trim(); if (!text) { alert('Comment cannot be empty'); return; } // Validering

      try { // Kall API
        const res = await fetch(`/api/posts/${encodeURIComponent(parentId)}/comments`, {
          method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ content: text })
        });
        if (res.status === 401) { alert('You must log in to comment.'); return; } // Ikke innlogget
        const data = await res.json(); if (!res.ok || !data.ok) { alert(data.error || 'Could not add comment'); return; } // API-feil

        const countEl = document.querySelector(`.comment-count[data-parent-id="${CSS.escape(parentId)}"]`); if (countEl) countEl.textContent = data.commentCount; // Oppdater teller

        const actionsRow = sendBtn.closest('.post-box').querySelector('.actions-row'); // Finn actions-rad
        let toggleBtn = actionsRow.querySelector(`.comments-toggle[data-parent-id="${CSS.escape(parentId)}"]`); // Finn toggle
        if (!toggleBtn) { toggleBtn = document.createElement('button'); toggleBtn.type = 'button'; toggleBtn.className = 'comments-toggle'; toggleBtn.setAttribute('data-parent-id', parentId); actionsRow.appendChild(toggleBtn); } // Lag toggle ved behov
        toggleBtn.textContent = 'Hide comments'; // Sett label

        const listEl = document.querySelector(`.comment-list[data-parent-id="${CSS.escape(parentId)}"]`); // Finn liste
        if (listEl) { // Hvis finnes
          listEl.classList.remove('hidden'); // Vis liste
          const wrapper = document.createElement('div'); wrapper.className = 'comment'; // Ny kommentar
          const header = document.createElement('p'); header.className = 'comment-header'; header.innerHTML = `<strong>${escapeHtml(data.comment.username)}</strong> • ${new Date(data.comment.created_at).toLocaleString('nb-NO')}`; // Header
          const body = document.createElement('p'); body.className = 'post-content'; body.textContent = data.comment.content; // Tekst
          wrapper.appendChild(header); wrapper.appendChild(body); // Sett sammen
          const firstComment = listEl.querySelector('.comment'); const pager = listEl.querySelector('.comments-pagination'); // Finn første/pager
          if (firstComment) { listEl.insertBefore(wrapper, firstComment); } // Sett ny øverst
          else if (pager) { listEl.insertBefore(wrapper, pager); } // Eller før pager
          else { listEl.appendChild(wrapper); } // Eller append

          renumberAndPaginate(listEl, 5); // Renummerer og oppdaterer synlighet
          ensurePagerAtBottom(listEl); // Pager nederst
          ensurePagerVisibility(listEl, parentId); // Pager-knapper
        }

        input.value = ''; input.style.height = 'auto'; // Tøm/reset
      } catch (err) { console.error('Comment error:', err); alert('Unexpected error'); } // Feil
      return; // Avslutt
    } // Slutt ny kommentar

    const toggleBtn = e.target.closest('.comments-toggle'); // Sjekk “View/Hide”-toggle (ikke more/less)
    if (toggleBtn && !toggleBtn.classList.contains('comments-more') && !toggleBtn.classList.contains('comments-less')) {
      const parentId = toggleBtn.dataset.parentId; const listEl = document.querySelector(`.comment-list[data-parent-id="${CSS.escape(parentId)}"]`); const countEl = document.querySelector(`.comment-count[data-parent-id="${CSS.escape(parentId)}"]`); const total = countEl ? Number(countEl.textContent) : 0; if (!listEl) return;
      if (listEl.classList.contains('hidden')) { listEl.classList.remove('hidden'); if (!listEl.dataset.visibleCount) listEl.dataset.visibleCount = String(Math.min(5, total)); renumberAndPaginate(listEl, 5); ensurePagerAtBottom(listEl); ensurePagerVisibility(listEl, parentId); toggleBtn.textContent = 'Hide comments'; }
      else { listEl.classList.add('hidden'); toggleBtn.textContent = total > 0 ? `View ${total} comments` : 'View comments'; }
      return;
    } // Slutt View/Hide

    const moreBtn = e.target.closest('.comments-more'); // “Show more”
    if (moreBtn) {
      const parentId = moreBtn.dataset.parentId; const listEl = document.querySelector(`.comment-list[data-parent-id="${CSS.escape(parentId)}"]`); if (!listEl) return;
      let visible = Number(listEl.dataset.visibleCount) || 5; const total = listEl.querySelectorAll('.comment').length; visible = Math.min(visible + 10, total); listEl.dataset.visibleCount = String(visible); applyVisibility(listEl, visible); ensurePagerAtBottom(listEl); updatePagerButtons(listEl); return;
    } // Slutt more

    const lessBtn = e.target.closest('.comments-less'); // “Show less”
    if (lessBtn) {
      const parentId = lessBtn.dataset.parentId; const listEl = document.querySelector(`.comment-list[data-parent-id="${CSS.escape(parentId)}"]`); if (!listEl) return;
      let visible = Number(listEl.dataset.visibleCount) || 5; visible = Math.max(5, visible - 10); listEl.dataset.visibleCount = String(visible); applyVisibility(listEl, visible); ensurePagerAtBottom(listEl); updatePagerButtons(listEl); return;
    } // Slutt less
  }); // Slutt click-lytter

  document.addEventListener('input', (e) => { // Auto-grow for kommentar-tekstfelt
    const ta = e.target.closest('.comment-input'); if (!ta) return; ta.style.height = 'auto'; ta.style.height = ta.scrollHeight + 'px';
  }); // Slutt input-lytter

  function renumberAndPaginate(listEl, baseline) { 
    const comments = Array.from(listEl.querySelectorAll('.comment')); 
    comments.forEach((el, i) => { el.dataset.idx = String(i); }); 
    let visible = Number(listEl.dataset.visibleCount) || baseline; 
    if (visible < baseline) visible = baseline; 
    if (visible > comments.length) visible = comments.length; 
    applyVisibility(listEl, visible); 
    listEl.dataset.visibleCount = String(visible); 
  } // Renummer + synlighet

  function applyVisibility(listEl, visible) { 
    const comments = Array.from(listEl.querySelectorAll('.comment')); 
    comments.forEach((el, i) => { el.classList.toggle('hidden', i >= visible); }); 
  } // Skjul/vis

  function ensurePagerAtBottom(listEl) { 
    const pager = listEl.querySelector('.comments-pagination'); 
    if (pager) listEl.appendChild(pager); 
  } // Pager nederst

  function ensurePagerVisibility(listEl, parentId) { 
    const total = listEl.querySelectorAll('.comment').length; 
    let pager = listEl.querySelector('.comments-pagination'); 
    if (!pager && total > 5) { 
      pager = document.createElement('div'); pager.className = 'comments-pagination'; 
      pager.setAttribute('data-parent-id', parentId); 
      const more = document.createElement('button'); 
      more.type = 'button'; 
      more.className = 'comments-toggle comments-more'; 
      more.setAttribute('data-parent-id', parentId); 
      more.textContent = 'Show more'; 
      const less = document.createElement('button'); 
      less.type = 'button'; 
      less.className = 'comments-toggle comments-less hidden'; 
      less.setAttribute('data-parent-id', parentId); 
      less.textContent = 'Show less'; 
      pager.appendChild(more); 
      pager.appendChild(less); 
      listEl.appendChild(pager); 
    } 
    updatePagerButtons(listEl); 
  } // Opprett/oppdater pager

  function updatePagerButtons(listEl) { 
    const total = listEl.querySelectorAll('.comment').length; 
    const visible = Number(listEl.dataset.visibleCount) || 5; 
    const moreBtn = listEl.querySelector('.comments-more'); 
    const lessBtn = listEl.querySelector('.comments-less'); 
    if (moreBtn) moreBtn.classList.toggle('hidden', visible >= total); 
    if (lessBtn) lessBtn.classList.toggle('hidden', visible <= 5); 
  } // Synlighet knapper

  function escapeHtml(s) { 
    return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;'); 
  } // HTML-escape
</script>

<%- include('partials/footer') %> <!-- Inkluderer footer-partial -->