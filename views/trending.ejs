<%- include('partials/header', { title: "Trending" }) %> <!-- Inkluderer header med tittel -->

<h1>Trending</h1> <!-- Overskrift for siden -->

<section class="posts-list"> <!-- Beholder for alle toppnivå-innlegg -->
    <% posts.forEach(post => { %> <!-- Løkke over hvert trending-innlegg -->
        <article class="post-box"> <!-- En boks per post -->
        <p> <!-- Topp-linje: forfatter + tid -->
            <strong><%= post.username %></strong> <!-- Forfatter -->
            • <!-- Skillepunkt -->
            <%= typeof formatPostTime === 'function' 
                ? formatPostTime(post.created_at) 
                : (post.created_at ? new Date(post.created_at).toLocaleString('nb-NO') : 'Ukjent tidspunkt') %> <!-- Tidsvisning -->
        </p> <!-- Slutt topp-linje -->

        <p class="post-content"><%= post.content %></p> <!-- Selve post-innholdet -->

        <div class="actions-row"> <!-- Rad med like-knapp og kommentarteller -->
            <button
            type="button"                                                   
            class="like-btn"                                                
            data-post-id="<%= post.PostID %>"                               
            aria-pressed="<%= post.liked ? 'true' : 'false' %>">            <!-- Tilgjengelighetstilstand -->
            <span class="like-label"><%= post.liked ? 'Unlike' : 'Like' %></span> <!-- Label -->
            ( <span class="like-count"><%= post.likeCount %></span> )             <!-- Like-teller -->
            </button> <!-- Slutt like-knapp -->

            <span class="comment-count" data-parent-id="<%= post.PostID %>"> <!-- Kommentarteller -->
            <%= post.commentCount %> <!-- Antall kommentarer -->
            </span> <!-- Slutt kommentarteller -->

            <% if (post.commentCount > 0) { %> <!-- Vis "View comments"-toggle hvis det finnes kommentarer -->
            <button
                type="button" 
                class="comments-toggle" 
                data-parent-id="<%= post.PostID %>"> <!-- Hvilken post sine kommentarer -->
                View <%= post.commentCount %> comments <!-- Standard: kollapset -->
            </button> <!-- Slutt toggle -->
            <% } %> <!-- Slutt if -->
        </div> <!-- Slutt actions-row -->

        <% if (userId) { %> <!-- Vis kommentarfeltet bare for innloggede -->
            <div class="comment-form-row"> <!-- Rad for input + "Send" -->
            <textarea
                class="comment-input"                                  
                data-parent-id="<%= post.PostID %>"                 
                placeholder="Write a comment..."       
                rows="1"></textarea>                                    <!-- Starter liten -->
            <button
                type="button"                                          
                class="comment-send"                                 
                data-parent-id="<%= post.PostID %>">                    <!-- Parent post id -->
                Send <!-- Knappetekst -->
            </button> <!-- Slutt send-knapp -->
            </div> <!-- Slutt comment-form-row -->
        <% } else { %> <!-- Hvis utlogget -->
            <small>Log in to comment</small> <!-- Liten veiledning -->
        <% } %> <!-- Slutt if -->

        <div class="comment-list hidden" data-parent-id="<%= post.PostID %>" data-visible-count="<%= Math.min(5, (commentsByParent[post.PostID] || []).length) %>"> <!-- Kommentarer: skjult ved start, baseline 5 -->
            <% const comments = commentsByParent[post.PostID] || []; %> <!-- Leser kommentarer for denne posten -->
            <% comments.forEach((c, i) => { %> <!-- Løkke over kommentarer med indeks -->
            <div class="comment <%= i >= 5 ? 'hidden' : '' %>" data-idx="<%= i %>"> <!-- Skjul alt etter de første 5 -->
                <p class="comment-header"> <!-- Forfatter + tid -->
                <strong><%= c.username %></strong> • 
                <%= typeof formatPostTime === 'function' 
                        ? formatPostTime(c.created_at) 
                        : (c.created_at ? new Date(c.created_at).toLocaleString('nb-NO') : 'Ukjent tidspunkt') %>
                </p> <!-- Slutt header -->
                <p class="post-content"><%= c.content %></p> <!-- Kommentartekst -->
            </div> <!-- Slutt én kommentar -->
            <% }) %> <!-- Slutt løkke over kommentarer -->
            <% if (comments.length > 5) { %> <!-- Paginering hvis flere enn 5 kommentarer -->
            <div class="comments-pagination" data-parent-id="<%= post.PostID %>"> <!-- Beholder for "more/less" -->
                <button type="button" class="comments-toggle comments-more" data-parent-id="<%= post.PostID %>">Show more</button> <!-- Vis +10 -->
                <button type="button" class="comments-toggle comments-less hidden" data-parent-id="<%= post.PostID %>">Show less</button> <!-- Vis -10 (skjult ved start) -->
            </div> <!-- Slutt pagination -->
            <% } %> <!-- Slutt if pagination -->
        </div> <!-- Slutt comment-list -->
        </article> <!-- Slutt én post -->
    <% }) %> <!-- Slutt løkke over poster -->
</section> <!-- Slutt posts-list -->

<%- include('partials/footer') %> <!-- Inkluderer footer -->