<!DOCTYPE html> <!-- Definerer dokumenttype -->
<html lang="no"> <!-- Setter språk til norsk -->
<head> <!-- Starter head -->
    <meta charset="UTF-8"> <!-- Tegnsett UTF-8 -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0"> <!-- Responsiv visning -->
    <title><%= (typeof title !== 'undefined' && title) ? title : 'Sharing Thoughts' %></title> <!-- Bruker side-tittel eller fallback -->
    <link rel="stylesheet" href="/styles.css"> <!-- Laster minimal CSS fra /public/styles.css -->
    <script src="/js/client.js" defer></script> <!-- Laster felles klientscript fra /public/js/client.js etter HTML-en er lastet -->
</head> <!-- Slutt head -->
<body> <!-- Starter body-innhold -->

<header class="site-header"> <!-- Header-område øverst -->
    <div class="container"> <!-- Sentrert container for header -->
        <nav class="nav"> <!-- Navigasjonsrad -->
        <div class="brand"> <!-- Område for “logo/brand” -->
            <a href="/">Sharing Thoughts</a> <!-- Enkel hjem-lenke med navn -->
        </div> <!-- Slutt brand -->
        <div class="links"> <!-- Område for nav-lenker -->
            <a href="/">Feed</a> <!-- Lenke til forsiden -->
            <% if (typeof userId !== 'undefined' && userId) { %>
                <a href="/profile">Profile</a> <!-- Lenke til profil -->
                <a href="/logout">Logout</a> <!-- Logg ut -->
            <% } else { %>
                <a href="/signup">Sign Up</a> <!-- Lenke til registrering -->
                <a href="/login">Login</a> <!-- Lenke til innlogging -->
            <% } %>
        </div> <!-- Slutt links -->
    </nav> <!-- Slutt nav -->
    </div> <!-- Slutt container -->
</header> <!-- Slutt header -->

<main class="container"> <!-- Starter hovedinnholdet i en sentrert container -->